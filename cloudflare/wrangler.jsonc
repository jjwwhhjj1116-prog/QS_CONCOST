{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "concost-migration-trial",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "assets": {
    "directory": "../tender_radar/static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": { "SCHEDULE_ENABLED": "false", "MAIL_MODE": "dry-run" },
  "triggers": { "crons": [] },
  "d1_databases": [{
    "binding": "DB", "database_name": "concost-migration-trial",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "containers": [{
    "class_name": "Collector", "image": "./Collector.Dockerfile",
    "image_build_context": "..", "max_instances": 2, "instance_type": "basic"
  }],
  "durable_objects": { "bindings": [{ "name": "COLLECTOR", "class_name": "Collector" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Collector"] }],
  "queues": {
    "producers": [{ "binding": "COLLECTION_QUEUE", "queue": "concost-trial-collection" }],
    "consumers": [{
      "queue": "concost-trial-collection", "max_batch_size": 1,
      "max_concurrency": 2, "max_retries": 1,
      "dead_letter_queue": "concost-trial-dead-letter"
    }]
  },
  "observability": { "enabled": true }
}
