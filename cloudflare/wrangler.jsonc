{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "concost-migration-trial",
  "main": "src/worker.js",
  "keep_names": false,
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "assets": {
    "directory": "../tender_radar/static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": { "SCHEDULE_ENABLED": "true", "MAIL_MODE": "live" },
  "triggers": { "crons": ["0 0 * * MON-FRI", "0 1 * * MON-FRI"] },
  "d1_databases": [{
    "binding": "DB", "database_name": "concost-migration-trial",
    "database_id": "ba8009cf-c015-4c98-ab01-d0e7f0768586",
    "migrations_dir": "migrations"
  }],
  "queues": {
    "producers": [{ "binding": "COLLECTION_QUEUE", "queue": "concost-trial-collection" },
      { "binding": "MAIL_QUEUE", "queue": "concost-mail-dispatch" }],
    "consumers": [{
      "queue": "concost-trial-collection", "max_batch_size": 1,
      "max_batch_timeout": 1, "max_concurrency": 5, "max_retries": 2,
      "dead_letter_queue": "concost-trial-dead-letter"
    }, {"queue":"concost-mail-dispatch", "max_batch_size":1, "max_batch_timeout":1,
      "max_concurrency":1,"max_retries":2}]
  },
  "observability": { "enabled": true }
}
